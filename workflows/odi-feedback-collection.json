    {
      "parameters": {
        "jsCode": "const q = $input.first().json.query || {};\n\nconst labels = {\n  \"1\": \"Not helpful\",\n  \"2\": \"Slightly helpful\",\n  \"3\": \"Neutral\",\n  \"4\": \"Helpful\",\n  \"5\": \"Very helpful\"\n};\n\nreturn [\n  {\n    json: {\n      timestamp: new Date().toISOString(),\n      thread_id: q.thread_id || \"\",\n      customer_email: q.email || \"\",\n      rating: q.rating || \"\",\n      rating_label: labels[q.rating] || \"Unknown\",\n      source: \"email_rating_link\"\n    }\n  }\n];"
      },
